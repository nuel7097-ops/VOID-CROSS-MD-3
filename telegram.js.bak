'use strict';

require('dotenv').config();

const fs   = require('fs');
const path = require('path');
const TelegramBot = require('node-telegram-bot-api');
const {
    requestPairForUser,
    getActiveSessions,
    listSavedSessions,
    registerCallbacks
} = require('./session_manager');

let bot = null;

const FORCE_JOIN_CHANNEL = 'FYT_13';
const CHANNEL_URL        = `https://t.me/${FORCE_JOIN_CHANNEL}`;
const chatPhoneMap       = new Map();

/* ── MarkdownV2 escape ─────────────────────────────────────────────────── */
function esc(text) {
    if (text === null || text === undefined) return '';
    return String(text).replace(/[_*[\]()~`>#+=|{}.!\\-]/g, '\\$&');
}

/* ── Bold blue link ────────────────────────────────────────────────────── */
function blue(label, url) {
    return `*[${esc(label)}](${url})*`;
}

/* ── Blue phone (taps to open WhatsApp) ────────────────────────────────── */
function bluePhone(phone) {
    return `*[\\+${phone}](https://wa.me/${phone})*`;
}

/* ── Reusable values ───────────────────────────────────────────────────── */
const BOT   = () => blue('FYT MD', CHANNEL_URL);
const OWNER = () => blue('LORDFYT', CHANNEL_URL);
const CH    = () => blue('FYT\\_13', CHANNEL_URL);

/* ── ZENITH CORE box builders ──────────────────────────────────────────── */
//  Header:  ╭═───⊱ TITLE ───═⬡
//  Row:    >│ ⸙ Field: Value       ← ">" makes Telegram render as blockquote
//  Footer:  ╰═─────────────═⬡

function boxHeader(title) {
    return `╭═───⊱ *${esc(title)}* ───═⬡`;
}

function boxRow(field, value) {
    return `>│ ⸙ ${esc(field)}: ${value}`;
}

const boxFoot = `╰═─────────────═⬡`;

/* ── Full card builder ─────────────────────────────────────────────────── */
function card(title, rows) {
    return [
        boxHeader(title),
        ...rows.map(([f, v]) => boxRow(f, v)),
        boxFoot
    ].join('\n');
}

/* ── Status card ───────────────────────────────────────────────────────── */
function statusCard(settings, active, saved) {
    const ver = esc(settings.version || '3.0.6');
    return (
        card(settings.botName || 'FYT MD', [
            ['Bot',      BOT()],
            ['Creator',  OWNER()],
            ['Version',  ver],
            ['Sessions', `${saved} saved \\/ ${active} active`],
            ['Status',   '👑 RUNNING']
        ]) +
        '\n\n' +
        `🔥 *"FYT MD RUNS THIS"*`
    );
}

/* ── Channel member check ──────────────────────────────────────────────── */
async function isChannelMember(chatId) {
    try {
        const m = await bot.getChatMember(`@${FORCE_JOIN_CHANNEL}`, chatId);
        return ['member', 'administrator', 'creator'].includes(m.status);
    } catch { return false; }
}

async function sendJoinRequired(chatId, name) {
    await bot.sendMessage(chatId,
        card('Access Denied', [
            ['User',    esc(name)],
            ['Channel', CH()],
            ['Status',  '❌ Not Joined']
        ]) +
        `\n\nJoin ${CH()} then press /start\\.`,
        {
            parse_mode: 'MarkdownV2',
            reply_markup: {
                inline_keyboard: [
                    [{ text: '📢 Join FYT_13 Channel', url: CHANNEL_URL }],
                    [{ text: '🔄 I Joined — Restart',  callback_data: 'check_join' }]
                ]
            }
        }
    );
}

/* ═══════════════════════════════════════════════════════════════════════
   BOT INIT
═══════════════════════════════════════════════════════════════════════ */
function initTelegramBot() {
    const token = process.env.TELEGRAM_BOT_TOKEN || require('./settings').telegramBotToken;

    if (!token || token === 'YOUR_TELEGRAM_BOT_TOKEN') {
        console.log('⚠️  TELEGRAM_BOT_TOKEN not set.');
        return null;
    }

    try {
        bot = new TelegramBot(token, { polling: true });
        console.log('🤖 FYT MD Telegram bot started!');

        /* ── Pair / Connection Callbacks ──────────────────────────────── */
        registerCallbacks({

            onPairCode: (phone, code, errMsg) => {
                const chatId = chatPhoneMap.get(phone);
                if (!chatId) return;

                if (!code) {
                    return bot.sendMessage(chatId,
                        card('Pairing Failed', [
                            ['Bot',    BOT()],
                            ['Number', bluePhone(phone)],
                            ['Status', '❌ Failed'],
                            ...(errMsg ? [['Reason', esc(errMsg)]] : [])
                        ]) +
                        `\n\nTap *Try Again* to retry\\.`,
                        {
                            parse_mode: 'MarkdownV2',
                            reply_markup: {
                                inline_keyboard: [[
                                    { text: '🔄 Try Again', callback_data: `retry_pair_${phone}` }
                                ]]
                            }
                        }
                    );
                }

                bot.sendMessage(chatId,
                    card('Your Pairing Code', [
                        ['Bot',    BOT()],
                        ['Number', bluePhone(phone)],
                        ['Code',   `\`${esc(code)}\``],
                        ['Status', '⏳ Waiting for WhatsApp']
                    ]) +
                    `\n\n📱 *How to link:*\n` +
                    `>┊ 1️⃣ Open WhatsApp\n` +
                    `>┊ 2️⃣ Tap ⋮ → Linked Devices\n` +
                    `>┊ 3️⃣ Tap Link a Device\n` +
                    `>┊ 4️⃣ Tap Link with phone number\n` +
                    `>┊ 5️⃣ Enter the code above\n\n` +
                    `_⏰ Code expires soon \\— act quickly\\!_`,
                    {
                        parse_mode: 'MarkdownV2',
                        reply_markup: {
                            inline_keyboard: [
                                [{ text: '✅ Done — I Entered the Code', callback_data: 'pair_done'           }],
                                [{ text: '🔄 Get a New Code',            callback_data: `retry_pair_${phone}` }],
                                [{ text: '❓ Need Help?',                 callback_data: 'pair_help'           }]
                            ]
                        }
                    }
                );
            },

            onConnected: (phone) => {
                const chatId = chatPhoneMap.get(phone);
                if (!chatId) return;
                bot.sendMessage(chatId,
                    card('Connected!', [
                        ['Bot',     BOT()],
                        ['Number',  bluePhone(phone)],
                        ['Creator', OWNER()],
                        ['Status',  '🟢 Active']
                    ]) +
                    `\n\nSend *\\.menu* on WhatsApp to get started\\!`,
                    {
                        parse_mode: 'MarkdownV2',
                        reply_markup: {
                            inline_keyboard: [
                                [{ text: '📋 WhatsApp Commands', callback_data: 'show_wa_cmds' }],
                                [{ text: '📊 Check Status',      callback_data: 'check_status'  }]
                            ]
                        }
                    }
                );
            },

            onDisconnected: (phone) => {
                const chatId = chatPhoneMap.get(phone);
                chatPhoneMap.delete(phone);
                if (!chatId) return;
                bot.sendMessage(chatId,
                    card('Disconnected', [
                        ['Bot',    BOT()],
                        ['Number', bluePhone(phone)],
                        ['Status', '🔴 Offline']
                    ]) +
                    `\n\nTap *Reconnect* to re\\-link\\.`,
                    {
                        parse_mode: 'MarkdownV2',
                        reply_markup: {
                            inline_keyboard: [[
                                { text: '🔄 Reconnect', callback_data: `retry_pair_${phone}` }
                            ]]
                        }
                    }
                );
            }
        });

        /* ── /start ───────────────────────────────────────────────────── */
        bot.onText(/\/start/, async (msg) => {
            const chatId = msg.chat.id;
            const name   = msg.from.first_name || 'User';

            const isMember = await isChannelMember(chatId);
            if (!isMember) return sendJoinRequired(chatId, name);

            const settings = require('./settings');
            const ver      = esc(settings.version || '3.0.6');

            const welcomeText =
                card(settings.botName || 'FYT MD', [
                    ['Bot',     BOT()],
                    ['Creator', OWNER()],
                    ['Version', ver],
                    ['Prefix',  `\\. \\( Dot \\)`],
                    ['Status',  '👑 ACTIVE']
                ]) +
                `\n\n👋 Welcome, *${esc(name)}*\\!\n\n` +
                `>┊ 1️⃣ Tap *Pair My WhatsApp* below\n` +
                `>┊ 2️⃣ Enter your number when asked\n` +
                `>┊ 3️⃣ Enter the code in WhatsApp\n` +
                `>┊ 4️⃣ Send *\\.menu* on WhatsApp\\!\n\n` +
                `🔥 *"FYT MD RUNS THIS"*`;

            const videoPath = path.join(__dirname, 'assets', 'menu.mp4');
            const sendOpts  = {
                parse_mode: 'MarkdownV2',
                reply_markup: {
                    inline_keyboard: [
                        [{ text: '🔗 Pair My WhatsApp',  callback_data: 'start_pair'   }],
                        [
                            { text: '📖 Help',   callback_data: 'show_help'    },
                            { text: '📊 Status', callback_data: 'check_status' }
                        ],
                        [{ text: '📢 Join Our Channel', url: CHANNEL_URL }]
                    ]
                }
            };

            if (fs.existsSync(videoPath)) {
                await bot.sendVideo(chatId, fs.createReadStream(videoPath), {
                    caption: welcomeText,
                    ...sendOpts,
                    supports_streaming: true
                }).catch(() => bot.sendMessage(chatId, welcomeText, sendOpts));
            } else {
                await bot.sendMessage(chatId, welcomeText, sendOpts);
            }
        });

        /* ── /pair ────────────────────────────────────────────────────── */
        bot.onText(/\/pair(?:\s+(.+))?/, async (msg, match) => {
            const chatId = msg.chat.id;
            const name   = msg.from.first_name || 'User';

            const isMember = await isChannelMember(chatId);
            if (!isMember) return sendJoinRequired(chatId, name);

            const phoneInput = match && match[1] ? match[1].trim() : null;

            if (!phoneInput) {
                return bot.sendMessage(chatId,
                    card('Pair Your WhatsApp', [
                        ['Bot',     BOT()],
                        ['Creator', OWNER()],
                        ['Usage',   '`/pair <phone\\_number>`'],
                        ['Example', '`/pair 2348012345678`'],
                        ['Note',    'Include country code, no \\+ or spaces']
                    ]),
                    {
                        parse_mode: 'MarkdownV2',
                        reply_markup: {
                            inline_keyboard: [[
                                { text: '❓ How to Pair', callback_data: 'pair_help' }
                            ]]
                        }
                    }
                );
            }

            const phone = phoneInput.replace(/[^0-9]/g, '');

            if (phone.length < 7 || phone.length > 15) {
                return bot.sendMessage(chatId,
                    card('Invalid Number', [
                        ['Bot',     BOT()],
                        ['Input',   `\`${esc(phoneInput)}\``],
                        ['Status',  'Invalid format'],
                        ['Example', '`2348012345678`']
                    ]),
                    {
                        parse_mode: 'MarkdownV2',
                        reply_markup: {
                            inline_keyboard: [[
                                { text: '🔄 Try Again', callback_data: 'start_pair' }
                            ]]
                        }
                    }
                );
            }

            const sessions = getActiveSessions();
            if (sessions.has(phone) && !sessions.get(phone).reconnecting) {
                return bot.sendMessage(chatId,
                    card('Already Linked!', [
                        ['Bot',    BOT()],
                        ['Number', bluePhone(phone)],
                        ['Status', '🟢 Connected']
                    ]) +
                    `\n\nSend *\\.menu* on WhatsApp to use the bot\\.`,
                    {
                        parse_mode: 'MarkdownV2',
                        reply_markup: {
                            inline_keyboard: [[
                                { text: '📊 Check Status', callback_data: 'check_status' }
                            ]]
                        }
                    }
                );
            }

            chatPhoneMap.set(phone, chatId);

            await bot.sendMessage(chatId,
                card('Generating Code...', [
                    ['Bot',    BOT()],
                    ['Number', bluePhone(phone)],
                    ['Status', '⚡ Please wait\\.\\.\\.']
                ]) +
                `\n\n_This may take a few seconds\\._`,
                { parse_mode: 'MarkdownV2' }
            );

            try {
                const result = await requestPairForUser(phone);
                if (result === 'ALREADY_CONNECTED') {
                    bot.sendMessage(chatId,
                        card('Already Connected!', [
                            ['Bot',    BOT()],
                            ['Number', bluePhone(phone)],
                            ['Status', '🟢 Active']
                        ]) +
                        `\n\nSend *\\.menu* on WhatsApp\\.`,
                        { parse_mode: 'MarkdownV2' }
                    );
                }
            } catch (err) {
                console.error('[Telegram] Pair error:', err.message);
                bot.sendMessage(chatId,
                    card('Error', [
                        ['Bot',    BOT()],
                        ['Number', bluePhone(phone)],
                        ['Reason', esc(err.message)]
                    ]) +
                    `\n\nPlease try again\\.`,
                    {
                        parse_mode: 'MarkdownV2',
                        reply_markup: {
                            inline_keyboard: [[
                                { text: '🔄 Try Again', callback_data: `retry_pair_${phone}` }
                            ]]
                        }
                    }
                );
            }
        });

        /* ── /sessions ────────────────────────────────────────────────── */
        bot.onText(/\/sessions/, async (msg) => {
            const chatId = msg.chat.id;
            const name   = msg.from.first_name || 'User';

            const isMember = await isChannelMember(chatId);
            if (!isMember) return sendJoinRequired(chatId, name);

            const saved  = listSavedSessions();
            const active = getActiveSessions();

            if (saved.length === 0) {
                return bot.sendMessage(chatId,
                    card('No Sessions Yet', [
                        ['Bot',     BOT()],
                        ['Creator', OWNER()],
                        ['Status',  'Waiting']
                    ]) +
                    `\n\nUse /pair to connect your WhatsApp\\.`,
                    {
                        parse_mode: 'MarkdownV2',
                        reply_markup: {
                            inline_keyboard: [[
                                { text: '🔗 Pair WhatsApp', callback_data: 'start_pair' }
                            ]]
                        }
                    }
                );
            }

            const lines = saved.map((phone, i) => {
                const entry  = active.get(phone);
                const status = entry && !entry.reconnecting ? '🟢 Connected' : '🔴 Offline';
                return `>│ ⸙ ${i + 1}\\. ${bluePhone(phone)} — ${status}`;
            });

            bot.sendMessage(chatId,
                `${boxHeader(`Sessions \\(${saved.length}\\)`)}\n` +
                `${boxRow('Bot',     BOT())}\n` +
                `${boxRow('Creator', OWNER())}\n` +
                `${lines.join('\n')}\n` +
                `${boxFoot}\n\n` +
                `🔥 *"FYT MD RUNS THIS"*`,
                {
                    parse_mode: 'MarkdownV2',
                    reply_markup: {
                        inline_keyboard: [
                            [{ text: '🔗 Add New Session', callback_data: 'start_pair'   }],
                            [{ text: '📊 Status',          callback_data: 'check_status' }]
                        ]
                    }
                }
            );
        });

        /* ── /status ──────────────────────────────────────────────────── */
        bot.onText(/\/status/, async (msg) => {
            const chatId = msg.chat.id;
            const name   = msg.from.first_name || 'User';

            const isMember = await isChannelMember(chatId);
            if (!isMember) return sendJoinRequired(chatId, name);

            const settings = require('./settings');
            bot.sendMessage(chatId,
                statusCard(settings, getActiveSessions().size, listSavedSessions().length),
                {
                    parse_mode: 'MarkdownV2',
                    reply_markup: {
                        inline_keyboard: [
                            [{ text: '📋 My Sessions', callback_data: 'show_sessions' }],
                            [{ text: '🔗 Add Session', callback_data: 'start_pair'    }]
                        ]
                    }
                }
            );
        });

        /* ── /help ────────────────────────────────────────────────────── */
        bot.onText(/\/help/, async (msg) => {
            const chatId = msg.chat.id;
            const name   = msg.from.first_name || 'User';

            const isMember = await isChannelMember(chatId);
            if (!isMember) return sendJoinRequired(chatId, name);

            bot.sendMessage(chatId,
                card('FYT MD — Help', [
                    ['Bot',     BOT()],
                    ['Creator', OWNER()],
                    ['Channel', CH()]
                ]) +
                `\n\n*Telegram Commands*\n` +
                `>│ ⸙ /start — Welcome & setup\n` +
                `>│ ⸙ /pair \\<phone\\> — Connect WhatsApp\n` +
                `>│ ⸙ /sessions — View linked accounts\n` +
                `>│ ⸙ /status — Bot status\n` +
                `>│ ⸙ /help — This menu\n\n` +
                `*WhatsApp Commands*\n` +
                `>│ ⸙ \\.menu — Full command list\n` +
                `>│ ⸙ \\.sticker — Create sticker\n` +
                `>│ ⸙ \\.tagall — Tag everyone\n` +
                `>│ ⸙ \\.owner — Contact owner\n` +
                `>│ ⸙ \\.ping — Check bot speed\n` +
                `>│ ⸙ \\.alive — Bot status\n` +
                `>│ ⸙ \\.\\.\\.and many more\\!\n\n` +
                `🔥 *"FYT MD RUNS THIS"*`,
                {
                    parse_mode: 'MarkdownV2',
                    reply_markup: {
                        inline_keyboard: [
                            [{ text: '🔗 Pair My WhatsApp', callback_data: 'start_pair'   }],
                            [
                                { text: '📊 Status',   callback_data: 'check_status'  },
                                { text: '📋 Sessions', callback_data: 'show_sessions' }
                            ],
                            [{ text: '📢 Join Channel', url: CHANNEL_URL }]
                        ]
                    }
                }
            );
        });

        /* ── Callbacks ────────────────────────────────────────────────── */
        bot.on('callback_query', async (query) => {
            const chatId = query.message.chat.id;
            const name   = query.from.first_name || 'User';
            const data   = query.data;

            await bot.answerCallbackQuery(query.id).catch(() => {});

            if (data === 'check_join') {
                const isMember = await isChannelMember(chatId);
                if (isMember) {
                    await bot.sendMessage(chatId,
                        card('Verified!', [
                            ['Bot',     BOT()],
                            ['User',    esc(name)],
                            ['Channel', CH()],
                            ['Status',  '🟢 Joined']
                        ]) +
                        `\n\nSend /start to begin\\.`,
                        { parse_mode: 'MarkdownV2' }
                    );
                } else {
                    await sendJoinRequired(chatId, name);
                }
                return;
            }

            if (data === 'start_pair') {
                await bot.sendMessage(chatId,
                    card('Pair Your WhatsApp', [
                        ['Bot',     BOT()],
                        ['Creator', OWNER()],
                        ['Usage',   '`/pair <phone\\_number>`'],
                        ['Example', '`/pair 2348012345678`'],
                        ['Note',    'Include country code, no \\+ or spaces']
                    ]),
                    { parse_mode: 'MarkdownV2' }
                );
                return;
            }

            if (data === 'pair_done') {
                await bot.sendMessage(chatId,
                    card('Linking...', [
                        ['Bot',     BOT()],
                        ['Creator', OWNER()],
                        ['Status',  'Waiting for WhatsApp\\.\\.\\.']
                    ]) +
                    `\n\n_You'll receive a confirmation shortly\\!_`,
                    { parse_mode: 'MarkdownV2' }
                );
                return;
            }

            if (data === 'pair_help') {
                await bot.sendMessage(chatId,
                    card('How to Pair', [
                        ['Bot',     BOT()],
                        ['Creator', OWNER()]
                    ]) +
                    `\n\n>│ ⸙ 1️⃣ Send: \`/pair <your\\_number>\`\n` +
                    `>│ ⸙ 2️⃣ Open WhatsApp → ⋮ Menu\n` +
                    `>│ ⸙ 3️⃣ Tap Linked Devices\n` +
                    `>│ ⸙ 4️⃣ Tap Link a Device\n` +
                    `>│ ⸙ 5️⃣ Tap Link with phone number\n` +
                    `>│ ⸙ 6️⃣ Enter the code sent here\n\n` +
                    `_Need help? Join_ ${CH()}`,
                    { parse_mode: 'MarkdownV2' }
                );
                return;
            }

            if (data === 'check_status') {
                const settings = require('./settings');
                await bot.sendMessage(chatId,
                    statusCard(settings, getActiveSessions().size, listSavedSessions().length),
                    { parse_mode: 'MarkdownV2' }
                );
                return;
            }

            if (data === 'show_sessions') {
                const saved  = listSavedSessions();
                const active = getActiveSessions();
                if (saved.length === 0) {
                    await bot.sendMessage(chatId,
                        card('No Sessions Yet', [
                            ['Bot',    BOT()],
                            ['Status', 'None connected']
                        ]) +
                        `\n\nUse /pair to connect\\.`,
                        { parse_mode: 'MarkdownV2' }
                    );
                    return;
                }
                const lines = saved.map((phone, i) => {
                    const entry  = active.get(phone);
                    const status = entry && !entry.reconnecting ? '🟢 Connected' : '🔴 Offline';
                    return `>│ ⸙ ${i + 1}\\. ${bluePhone(phone)} — ${status}`;
                });
                await bot.sendMessage(chatId,
                    `${boxHeader(`Sessions \\(${saved.length}\\)`)}\n` +
                    `${boxRow('Bot',     BOT())}\n` +
                    `${boxRow('Creator', OWNER())}\n` +
                    `${lines.join('\n')}\n` +
                    `${boxFoot}\n\n` +
                    `🔥 *"FYT MD RUNS THIS"*`,
                    { parse_mode: 'MarkdownV2' }
                );
                return;
            }

            if (data === 'show_wa_cmds') {
                await bot.sendMessage(chatId,
                    card('WhatsApp Commands', [
                        ['Bot',     BOT()],
                        ['Creator', OWNER()]
                    ]) +
                    `\n>│ ⸙ \\.menu — Full command list\n` +
                    `>│ ⸙ \\.help — Help menu\n` +
                    `>│ ⸙ \\.alive — Bot status\n` +
                    `>│ ⸙ \\.owner — Contact owner\n` +
                    `>│ ⸙ \\.sticker — Create sticker\n` +
                    `>│ ⸙ \\.tagall — Tag everyone\n` +
                    `>│ ⸙ \\.ping — Check speed\n` +
                    `>│ ⸙ \\.\\.\\.and many more\\!\n\n` +
                    `🔥 *"FYT MD RUNS THIS"*`,
                    { parse_mode: 'MarkdownV2' }
                );
                return;
            }

            if (data === 'show_help') {
                await bot.sendMessage(chatId,
                    card('Help Menu', [
                        ['Bot',     BOT()],
                        ['Creator', OWNER()]
                    ]) +
                    `\n>│ ⸙ /start — Welcome & setup\n` +
                    `>│ ⸙ /pair \\<phone\\> — Connect WhatsApp\n` +
                    `>│ ⸙ /sessions — View linked accounts\n` +
                    `>│ ⸙ /status — Bot status\n` +
                    `>│ ⸙ /help — Full help menu\n\n` +
                    `🔥 *"FYT MD RUNS THIS"*`,
                    { parse_mode: 'MarkdownV2' }
                );
                return;
            }

            if (data && data.startsWith('retry_pair_')) {
                const phone = data.replace('retry_pair_', '');
                await bot.sendMessage(chatId,
                    card('Retry Pairing', [
                        ['Bot',    BOT()],
                        ['Number', bluePhone(phone)],
                        ['Status', 'Ready to retry']
                    ]) +
                    `\n\nSend this to re\\-pair:\n\n\`/pair ${phone}\``,
                    { parse_mode: 'MarkdownV2' }
                );
                return;
            }
        });

        bot.on('polling_error', (err) => {
            console.error('[Telegram] Polling error:', err.message);
        });

        return bot;
    } catch (err) {
        console.error('[Telegram] Failed to start bot:', err.message);
        return null;
    }
}

function getBot() { return bot; }

module.exports = { initTelegramBot, getBot };
